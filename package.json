{
  "name": "cloudnex-local-llm-studio",
  "version": "0.1.0",
  "description": "Cross-platform desktop studio for local PyTorch language model workflows.",
  "main": "main.js",
  "private": true,
  "author": "Mohammed Sheik <https://cloudnex.co.za>",
  "homepage": "https://cloudnex.co.za",
  "license": "SEE LICENSE IN installer/LICENSE.txt",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "node -c server.js && node -c main.js && node -c preload.js",
    "clean": "rm -rf dist build backend/build backend/dist *.zip *.tar.gz *.tgz",
    "zip:clean": "npm run clean && zip -r -9 cloudnex-studio.zip . -x 'node_modules/*' -x 'dist/*' -x '.git/*'",
    "electron": "electron .",
    "electron:dev": "electron .",
    "backend": "python backend/app.py",
    "test:visual": "node tests/electron_visual.js",
    "build:backend": "python scripts/build_backend.py",
    "build": "npm run build:backend && electron-builder --publish never",
    "dist:win": "npm run build:backend && electron-builder --win --publish never",
    "dist:mac": "npm run build:backend && electron-builder --mac --publish never",
    "dist:linux": "npm run build:backend && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cloudnex.local-llm-studio",
    "productName": "CloudNex Local LLM Studio",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "bin",
        "filter": [
          "cloudnex-*",
          "!*.log"
        ]
      },
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "cloudnex-backend*",
          "!*.log"
        ]
      },
      {
        "from": "scripts",
        "to": "engine/scripts"
      },
      {
        "from": "src",
        "to": "engine/src"
      },
      {
        "from": "config",
        "to": "engine/config"
      },
      {
        "from": "data_loader",
        "to": "engine/data_loader"
      },
      {
        "from": "configs",
        "to": "engine/configs"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/LICENSE.txt",
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": null
  }
}